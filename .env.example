# Self-hosted, OpenAI-compatible model endpoint. Only LLM_BASE_URL is required.
LLM_BASE_URL=http://llm-host:8000/v1
# Blank = use the model the endpoint serves (gpt-oss-120b is preferred, see config.yaml).
LLM_MODEL=
LLM_API_KEY=not-needed

# Email report page: your organisation's SMTP relay. Leave SMTP_HOST blank to switch sending off
# (the page can still download the email as an .eml file to send from Outlook).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=security-dashboard@example.com
